# Backend — secretos, NUNCA van en la app ni en Git. Copia este archivo como .env y completa los valores.
PORT=3000
# Dirección con la que el celular llega a este servidor: la IP del computador en la Wi-Fi (ipconfig getifaddr en0)
PUBLIC_URL=http://192.168.0.0:3000
# Token de acceso de Mercado Pago (credenciales de PRUEBA)
MERCADOPAGO_ACCESS_TOKEN=
# Clave de servicio de Firebase Admin, relativa a la carpeta backend/ (el archivo está ignorado por Git)
FIREBASE_SERVICE_ACCOUNT_PATH=./src/services/serviceAccount.json
