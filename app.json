{
  "expo": {
    "name": "uberclone-driver",
    "slug": "uberclone-driver",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "cameraPermission": "UberClone Conductor usa la cámara para tomar tu foto de perfil y la del vehículo.",
          "photosPermission": "UberClone Conductor accede a tus fotos para que elijas tu foto de perfil y la del vehículo.",
          "microphonePermission": false
        }
      ]
    ]
  }
}
